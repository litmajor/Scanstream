{
  "name": "scanstream",
  "version": "2.2.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsup server/index.ts --format esm --target es2022 --out-dir dist --external vite --external @vitejs/plugin-react --external lightningcss --external chartjs-node-canvas --external @babel/preset-typescript",
    "preview": "vite preview",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "measure:indicator-cost": "tsx scripts/measure-indicator-cost.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:apply-sql": "node server/scripts/run_sql_migrations.cjs",
    "logs": "tail -f logs/server-*.log 2>/dev/null || echo 'No logs found'",
    "logs:win": "powershell Get-Content -Path logs/server-*.log -Tail 50 -Wait"
  },
  "devDependencies": {
